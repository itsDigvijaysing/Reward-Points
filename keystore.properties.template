# Copy this file to keystore.properties (gitignored) and fill in real values
# before running ./gradlew assembleRelease for distribution.
#
# Generate a keystore once with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias statup
#
# All paths are relative to the project root.
storeFile=release.jks
storePassword=
keyAlias=statup
keyPassword=
